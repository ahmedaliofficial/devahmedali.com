# Google Search Console verification token (the content of the meta tag, not the full tag).
# Read at build time; leave empty to omit the tag. In Docker it must be passed as a build arg.
GOOGLE_SITE_VERIFICATION=

# Contact form delivery (Resend — https://resend.com).
# Without RESEND_API_KEY the form still renders and falls back to a direct mailto link.
RESEND_API_KEY=
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=ahmedalidev786@gmail.com
# Must be a domain verified in your Resend account
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID (Admin -> Data streams -> your web stream).
# Optional: src/config/analytics.ts already defaults to this site's own property, so leave this
# empty for a normal build. Set it to your own G-XXXXXXXXXX in a fork, or to nothing-but-whitespace
# to switch analytics off, in which case the privacy policy says the site runs none.
# Read at BUILD time (pages are prerendered); in Docker it must be passed as a build arg.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense publisher id, from AdSense → Account → Settings → Account information.
# Either form works: "pub-XXXXXXXXXXXXXXXX" (as shown in the ads.txt snippet) or "ca-pub-XXXXXXXXXXXXXXXX" (as shown in the ad code).
# When set: the AdSense loader goes into <head> on every page, /ads.txt is served, and the privacy
# policy, terms and footer show the advertising disclosures and a "Privacy settings" link.
# Leave empty to run the site with no ads at all. Must be present at BUILD time, not only at runtime.
NEXT_PUBLIC_ADSENSE_CLIENT=
