# Google Search Console verification token (the content of the meta tag, not the full tag).
# Read at build time; leave empty to omit the tag. In Docker it must be passed as a build arg.
GOOGLE_SITE_VERIFICATION=

# Contact form delivery (Resend — https://resend.com).
# Without RESEND_API_KEY the form still renders and falls back to a direct mailto link.
RESEND_API_KEY=
# Where contact form submissions are delivered
CONTACT_TO_EMAIL=ahmedalidev786@gmail.com
# Must be a domain verified in your Resend account
CONTACT_FROM_EMAIL=onboarding@resend.dev
